DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tutor
AUTH_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Aktualne stawki danego modelu w USD za 1 mln tokenów. Dla gpt-5.4-mini
# aplikacja ma te wartości jako domyślne; przy innym modelu ustaw je jawnie.
OPENAI_INPUT_USD_PER_1M_TOKENS=0.75
OPENAI_CACHED_INPUT_USD_PER_1M_TOKENS=0.075
OPENAI_OUTPUT_USD_PER_1M_TOKENS=4.50
INTERNET_VISUALS_ENABLED=true
SOURCE_ASSET_STORAGE=local
SOURCE_ASSET_S3_BUCKET=
SOURCE_ASSET_S3_PREFIX=textbook/unit-1/assets
AWS_REGION=eu-central-1
AI_RATE_LIMIT_PER_10_MINUTES=30
AI_RATE_LIMIT_PER_DAY=200
EVALS_ALLOW_DATABASE_WRITES=false
EVAL_STUDENT_MODEL=
EVAL_JUDGE_MODEL=
EVAL_MAX_TURNS=180
EVAL_MAX_OBJECTIVE_TURNS=8
EVAL_MAX_CONCEPT_TURNS=12
EVAL_INPUT_USD_PER_MILLION=
EVAL_OUTPUT_USD_PER_MILLION=
