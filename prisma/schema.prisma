generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CourseLevel {
  BASIC
  ADVANCED
}

enum SessionPhase {
  DIAGNOSTIC
  PLAN
  LEARNING
  MOCK_EXAM
  COMPLETED
}

enum MessageRole {
  TUTOR
  STUDENT
}

enum AssessmentRating {
  INCORRECT
  PARTIALLY_CORRECT
  CORRECT
  TRANSFER_DEMONSTRATED
}

enum NextAction {
  PROBE
  GUIDED_QUESTION
  HINT
  EXPLAIN
  WORKED_EXAMPLE
  TRANSFER_QUESTION
  NEXT_OBJECTIVE
  SHOW_PLAN
  COMPLETE_SESSION
}

enum SourceStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum SessionObjectiveStatus {
  NOT_STARTED
  DIAGNOSING
  LEARNING
  MASTERED
}

enum LearningStep {
  EXPLAIN
  PRACTICE
  TRANSFER
}

enum QuestionIntent {
  DIAGNOSTIC
  PRACTICE
  CORRECTION
  TRANSFER
  UNDERSTANDING_CHECK
}

enum ConceptFamiliarity {
  UNKNOWN
  NOT_FAMILIAR
  SOMEWHAT_FAMILIAR
  FAMILIAR
}

enum ConceptSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  RESET
}

enum ConceptSessionPhase {
  ORIENT
  EXPLAIN
  PRACTICE
  CHECK
}

enum ConceptRelationType {
  PREREQUISITE
  RELATED
  PART_OF
  CONTRASTS_WITH
}

enum ConceptOrigin {
  CURATED
  AI_GENERATED
}

enum ConceptReviewStatus {
  APPROVED
  PENDING_REVIEW
  REJECTED
}

enum AIUsageFeature {
  TUTOR_TURN
  CONCEPT_TUTOR_TURN
  CONCEPT_GENERATION
  SIDE_CHAT
  QUICK_EXPLANATION
  TEST_SCOPE_PARSING
}

enum AIUsageStatus {
  COMPLETED
  FAILED
}

enum TutorFeedbackTarget {
  STUDY_MESSAGE
  CONCEPT_MESSAGE
  SIDE_CHAT_MESSAGE
}

enum TutorFeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum LearningEventType {
  SESSION_STARTED
  SESSION_RESUMED
  SESSION_PAUSED
  SESSION_COMPLETED
  ANSWER_SUBMITTED
  DIAGNOSTIC_SKIPPED
  SIDE_QUESTION_SUBMITTED
  QUICK_EXPLANATION_REQUESTED
  CONCEPT_OPENED
  TUTOR_FEEDBACK_SUBMITTED
  TEST_PLAN_DRAFTED
  TEST_PLAN_CONFIRMED
}

enum TestPlanStatus {
  DRAFT
  CONFIRMED
  ARCHIVED
}

enum TestObjectiveScope {
  INCLUDED
  EXCLUDED
  PRIORITY
}

enum TestObjectiveScopeSource {
  CURRICULUM
  AI_SUGGESTION
  STUDENT_CONFIRMED
}

model School {
  id        String   @id @default(cuid())
  name      String
  city      String
  createdAt DateTime @default(now())
  courses   Course[]
}

model CurriculumVersion {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  validFrom   DateTime?
  validTo     DateTime?
  tutorGuardrails Json @default("[]")
  createdAt   DateTime @default(now())
  courses     Course[]
  sourceLinks KnowledgeSourceCurriculum[]
  concepts    Concept[]
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
  expiresAt   DateTime
  updatedAt   DateTime

  @@index([expiresAt])
}

model Subject {
  id      String   @id @default(cuid())
  code    String   @unique
  name    String
  courses Course[]
}

model Course {
  id                  String @id @default(cuid())
  schoolId            String
  curriculumVersionId String
  subjectId           String
  grade               Int
  level               CourseLevel
  title               String
  active              Boolean @default(true)
  school              School @relation(fields: [schoolId], references: [id])
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id])
  subject             Subject @relation(fields: [subjectId], references: [id])
  units               Unit[]
  enrollments         Enrollment[]

  @@unique([schoolId, curriculumVersionId, subjectId, grade, level])
}

model Unit {
  id          String @id @default(cuid())
  courseId    String
  slug        String
  title       String
  order       Int
  description String
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics      Topic[]
  sessions    StudySession[]
  sourceLinks KnowledgeSourceUnit[]
  testPlans   TestPlan[]

  @@unique([courseId, slug])
  @@unique([courseId, order])
}

model Topic {
  id          String @id @default(cuid())
  unitId      String
  title       String
  order       Int
  unit        Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  objectives  LearningObjective[]
  sourceLinks KnowledgeSourceTopic[]

  @@unique([unitId, order])
}

model LearningObjective {
  id                   String @id @default(cuid())
  topicId              String
  code                 String @unique
  title                String
  order                Int
  description          String
  diagnosticPrompt     String
  transferPrompt       String
  hook                 String
  microExplanation     String
  workedExample        String
  practicePrompt       String
  visualData           Json
  importance           Float @default(1)
  maturaRelevant       Boolean @default(false)
  maturaRequirementId  String?
  active               Boolean @default(true)
  topic                Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  masteries            StudentMastery[]
  assessmentObjectives AssessmentObjective[]
  reviewSchedules      ReviewSchedule[]
  sourceLinks          KnowledgeSourceObjective[]
  sessionStates        SessionObjectiveState[]
  tutorMessages        TutorMessage[]
  visualAssets         KnowledgeAsset[]
  concepts             ConceptObjective[]
  conceptEvidence      ConceptEvidence[]
  conceptAssessments   ConceptAssessment[]
  sideChatMessages     SideChatMessage[]
  learningEvents       LearningEvent[]
  testPlanObjectives   TestPlanObjective[]

  @@unique([topicId, order])
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  isSynthetic  Boolean @default(false)
  createdAt    DateTime @default(now())
  profile      StudentProfile?

  @@index([isSynthetic])
}

model StudentProfile {
  id          String @id @default(cuid())
  userId      String @unique
  displayName String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  masteries   StudentMastery[]
  sessions    StudySession[]
  reviews     ReviewSchedule[]
  conceptStates StudentConceptState[]
  conceptEvidence ConceptEvidence[]
  conceptSessions ConceptSession[]
  generatedConcepts Concept[] @relation("ConceptCreator")
  aiUsageEvents AiUsageEvent[]
  tutorFeedback TutorResponseFeedback[]
  learningEvents LearningEvent[]
  testPlans TestPlan[]
}

model Enrollment {
  id        String @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model StudentMastery {
  id                  String @id @default(cuid())
  studentId           String
  learningObjectiveId String
  mastery             Float @default(0)
  confidence          Float @default(0)
  attempts            Int @default(0)
  lastPracticedAt     DateTime?
  updatedAt           DateTime @updatedAt
  student             StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)

  @@unique([studentId, learningObjectiveId])
}

model StudySession {
  id                 String @id @default(cuid())
  studentId          String
  unitId             String
  phase              SessionPhase @default(DIAGNOSTIC)
  currentObjectiveId String?
  scaffoldLevel      Int @default(0)
  objectiveAttempts  Int @default(0)
  awaitingUnderstandingCheck Boolean @default(false)
  promptVersion      String @default("tutor-v1")
  startedAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  pausedAt           DateTime?
  endedAt            DateTime?
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit               Unit @relation(fields: [unitId], references: [id])
  messages           TutorMessage[]
  answers            StudentAnswer[]
  teacherScopeNote   TeacherScopeNote?
  objectiveStates    SessionObjectiveState[]
  conceptSessions    ConceptSession[]
  sideChatMessages   SideChatMessage[]
  aiUsageEvents      AiUsageEvent[]
  learningEvents     LearningEvent[]
  testPlanId         String?
  testPlan           TestPlan? @relation(fields: [testPlanId], references: [id], onDelete: SetNull)

  @@index([studentId, unitId, endedAt])
  @@index([testPlanId])
}

model TestPlan {
  id                    String @id @default(cuid())
  studentId             String
  unitId                String
  status                TestPlanStatus @default(DRAFT)
  testDate              DateTime
  dailyMinutes          Int
  originalTeacherNote   String?
  interpretationSummary String?
  expectedTaskTypes     Json @default("[]")
  declaredPageRanges    Json @default("[]")
  confirmedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  student               StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit                  Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  objectives            TestPlanObjective[]
  sessions              StudySession[]

  @@index([studentId, unitId, status, updatedAt])
  @@index([testDate, status])
}

model TestPlanObjective {
  testPlanId           String
  learningObjectiveId  String
  suggestedScope       TestObjectiveScope
  confirmedScope       TestObjectiveScope?
  source               TestObjectiveScopeSource
  reason               String?
  testPlan             TestPlan @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  learningObjective    LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)

  @@id([testPlanId, learningObjectiveId])
  @@index([learningObjectiveId, confirmedScope])
}

model SessionObjectiveState {
  sessionId           String
  learningObjectiveId String
  status              SessionObjectiveStatus @default(NOT_STARTED)
  diagnosticAttempts  Int @default(0)
  practicedAttempts   Int @default(0)
  consecutiveStruggles Int @default(0)
  clarificationAttempts Int @default(0)
  workedExamplesShown Int @default(0)
  learningStep         LearningStep @default(EXPLAIN)
  updatedAt           DateTime @updatedAt
  session             StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)

  @@id([sessionId, learningObjectiveId])
  @@index([sessionId, status])
}

model TeacherScopeNote {
  id        String @id @default(cuid())
  sessionId String @unique
  content   String
  createdAt DateTime @default(now())
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model TutorMessage {
  id        String @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String
  learningObjectiveId String?
  questionIntent QuestionIntent?
  questionFingerprint String?
  conceptMentions Json @default("[]")
  knowledgeAssetId String?
  showVisual Boolean @default(false)
  createdAt DateTime @default(now())
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learningObjective LearningObjective? @relation(fields: [learningObjectiveId], references: [id])
  knowledgeAsset KnowledgeAsset? @relation(fields: [knowledgeAssetId], references: [id], onDelete: SetNull)
  returningConceptSessions ConceptSession[] @relation("ConceptSessionReturnMessage")

  @@index([sessionId, createdAt])
  @@index([sessionId, learningObjectiveId, questionIntent])
  @@index([knowledgeAssetId])
}

model SideChatMessage {
  id                  String @id @default(cuid())
  studySessionId      String
  submissionId        String? @unique
  role                MessageRole
  content             String
  learningObjectiveId String?
  linkedConceptId     String?
  sourceLocators      Json?
  providerResponseId  String?
  model               String?
  promptVersion       String?
  latencyMs           Int?
  inputTokens         Int?
  outputTokens        Int?
  createdAt           DateTime @default(now())
  studySession        StudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  learningObjective   LearningObjective? @relation(fields: [learningObjectiveId], references: [id], onDelete: SetNull)
  linkedConcept       Concept? @relation(fields: [linkedConceptId], references: [id], onDelete: SetNull)

  @@index([studySessionId, createdAt])
  @@index([linkedConceptId])
}

model StudentAnswer {
  id        String @id @default(cuid())
  sessionId String
  content   String
  submissionId String? @unique
  createdAt DateTime @default(now())
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assessment Assessment?
}

model Assessment {
  id                 String @id @default(cuid())
  studentAnswerId    String @unique
  rating             AssessmentRating
  studentIntent      String?
  evidenceLevel      String?
  masteryDelta       Float
  proposedMasteryDelta Float?
  nextAction         NextAction
  rationale          String
  providerResponseId String?
  model              String
  promptVersion      String
  latencyMs          Int?
  inputTokens        Int?
  outputTokens       Int?
  knowledgeLocators  Json?
  createdAt          DateTime @default(now())
  studentAnswer      StudentAnswer @relation(fields: [studentAnswerId], references: [id], onDelete: Cascade)
  objectives         AssessmentObjective[]
  misconceptions     AssessmentMisconception[]
  conceptEvidence    ConceptEvidence[]
}

model AssessmentObjective {
  assessmentId       String
  learningObjectiveId String
  masteryBefore      Float?
  masteryAfter       Float?
  confidenceBefore   Float?
  confidenceAfter    Float?
  assessment         Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  learningObjective  LearningObjective @relation(fields: [learningObjectiveId], references: [id])

  @@id([assessmentId, learningObjectiveId])
}

model Misconception {
  id          String @id @default(cuid())
  code        String @unique
  description String
  assessments AssessmentMisconception[]
}

model AssessmentMisconception {
  assessmentId   String
  misconceptionId String
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  misconception  Misconception @relation(fields: [misconceptionId], references: [id])

  @@id([assessmentId, misconceptionId])
}

model ReviewSchedule {
  id                  String @id @default(cuid())
  studentId           String
  learningObjectiveId String
  dueAt               DateTime
  intervalDays        Int @default(1)
  easeFactor          Float @default(2.5)
  repetitions         Int @default(0)
  student             StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)

  @@unique([studentId, learningObjectiveId])
  @@index([studentId, dueAt])
}

model KnowledgeSource {
  id          String @id @default(cuid())
  title       String
  sourceType  String
  provenance  String
  rightsNote  String
  version     String?
  status      SourceStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  chunks      KnowledgeChunk[]
  curricula   KnowledgeSourceCurriculum[]
  units       KnowledgeSourceUnit[]
  topics      KnowledgeSourceTopic[]
  objectives  KnowledgeSourceObjective[]
  assets      KnowledgeAsset[]
}

model KnowledgeAsset {
  id                  String @id @default(cuid())
  key                 String @unique
  learningObjectiveId String
  knowledgeSourceId   String?
  sourceType          String
  mediaType           String @default("image/png")
  localFileName       String?
  externalUrl         String?
  sourcePage          Int?
  caption             String
  altText             String
  attribution         String
  rightsNote          String
  priority            Int @default(100)
  status              SourceStatus @default(DRAFT)
  metadata            Json?
  createdAt           DateTime @default(now())
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)
  knowledgeSource     KnowledgeSource? @relation(fields: [knowledgeSourceId], references: [id], onDelete: SetNull)
  tutorMessages       TutorMessage[]

  @@index([learningObjectiveId, status, priority])
}

model KnowledgeChunk {
  id        String @id @default(cuid())
  sourceId  String
  content   String
  locator   String?
  metadata  Json?
  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  concepts  ConceptSource[]

  @@index([sourceId])
}

model Concept {
  id                    String @id @default(cuid())
  curriculumVersionId   String
  slug                  String
  name                  String
  shortDefinition       String
  simpleExplanation     String
  whyItMatters          String
  commonMisconception   String?
  concreteExample       String?
  checkQuestion         String?
  transferQuestion      String?
  visualData            Json?
  active                Boolean @default(true)
  origin                ConceptOrigin @default(CURATED)
  reviewStatus          ConceptReviewStatus @default(APPROVED)
  createdForStudentId   String?
  sourceQuestion        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  curriculumVersion     CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  createdForStudent     StudentProfile? @relation("ConceptCreator", fields: [createdForStudentId], references: [id], onDelete: Cascade)
  aliases               ConceptAlias[]
  objectives            ConceptObjective[]
  sources               ConceptSource[]
  studentStates         StudentConceptState[]
  evidence              ConceptEvidence[]
  sessions              ConceptSession[]
  outgoingRelations     ConceptRelation[] @relation("ConceptRelationSource")
  incomingRelations     ConceptRelation[] @relation("ConceptRelationTarget")
  sideChatMessages      SideChatMessage[]

  @@unique([curriculumVersionId, slug])
  @@index([curriculumVersionId, active])
  @@index([createdForStudentId, reviewStatus])
}

model ConceptAlias {
  id              String @id @default(cuid())
  conceptId       String
  alias           String
  normalizedAlias String
  concept         Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([conceptId, normalizedAlias])
  @@index([normalizedAlias])
}

model ConceptObjective {
  conceptId          String
  learningObjectiveId String
  importance         Float @default(1)
  concept            Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  learningObjective  LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)

  @@id([conceptId, learningObjectiveId])
  @@index([learningObjectiveId])
}

model ConceptRelation {
  sourceConceptId String
  targetConceptId String
  relationType    ConceptRelationType
  sourceConcept   Concept @relation("ConceptRelationSource", fields: [sourceConceptId], references: [id], onDelete: Cascade)
  targetConcept   Concept @relation("ConceptRelationTarget", fields: [targetConceptId], references: [id], onDelete: Cascade)

  @@id([sourceConceptId, targetConceptId, relationType])
  @@index([targetConceptId, relationType])
}

model ConceptSource {
  conceptId        String
  knowledgeChunkId String
  concept          Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  knowledgeChunk   KnowledgeChunk @relation(fields: [knowledgeChunkId], references: [id], onDelete: Cascade)

  @@id([conceptId, knowledgeChunkId])
  @@index([knowledgeChunkId])
}

model StudentConceptState {
  studentId        String
  conceptId        String
  selfFamiliarity  ConceptFamiliarity @default(UNKNOWN)
  mastery          Float @default(0)
  confidence       Float @default(0)
  attempts         Int @default(0)
  evidenceCount    Int @default(0)
  lastPracticedAt  DateTime?
  updatedAt        DateTime @updatedAt
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept          Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([studentId, conceptId])
  @@index([studentId, mastery])
}

model ConceptEvidence {
  id                  String @id @default(cuid())
  studentId           String
  conceptId           String
  assessmentId        String
  learningObjectiveId String
  evidenceLevel       String
  masteryBefore       Float
  masteryAfter        Float
  createdAt           DateTime @default(now())
  student             StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept             Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  assessment          Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)

  @@unique([conceptId, assessmentId])
  @@index([studentId, conceptId, createdAt])
}

model ConceptSession {
  id                   String @id @default(cuid())
  studentId            String
  conceptId            String
  parentStudySessionId String
  returnToMessageId    String?
  parentConceptSessionId String?
  status               ConceptSessionStatus @default(ACTIVE)
  phase                ConceptSessionPhase @default(ORIENT)
  scaffoldLevel        Int @default(0)
  startedAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  endedAt              DateTime?
  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept              Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  parentStudySession   StudySession @relation(fields: [parentStudySessionId], references: [id], onDelete: Cascade)
  returnToMessage      TutorMessage? @relation("ConceptSessionReturnMessage", fields: [returnToMessageId], references: [id], onDelete: SetNull)
  parentConceptSession ConceptSession? @relation("ConceptSessionBranches", fields: [parentConceptSessionId], references: [id], onDelete: SetNull)
  childConceptSessions ConceptSession[] @relation("ConceptSessionBranches")
  messages             ConceptMessage[]
  aiUsageEvents        AiUsageEvent[]

  @@index([studentId, status, updatedAt])
  @@index([parentStudySessionId, status])
  @@index([parentConceptSessionId, status])
}

model AiUsageEvent {
  id                         String @id @default(cuid())
  studentId                  String
  studySessionId             String?
  conceptSessionId           String?
  feature                    AIUsageFeature
  status                     AIUsageStatus
  provider                   String @default("openai")
  providerResponseId         String? @unique
  model                      String
  promptVersion              String
  latencyMs                  Int
  inputTokens                Int?
  cachedInputTokens          Int?
  outputTokens               Int?
  reasoningOutputTokens      Int?
  totalTokens                Int?
  inputUsdPerMillion         Decimal? @db.Decimal(12, 6)
  cachedInputUsdPerMillion   Decimal? @db.Decimal(12, 6)
  outputUsdPerMillion        Decimal? @db.Decimal(12, 6)
  estimatedCostUsd           Decimal? @db.Decimal(14, 8)
  errorType                  String?
  createdAt                  DateTime @default(now())
  student                    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studySession               StudySession? @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  conceptSession             ConceptSession? @relation(fields: [conceptSessionId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([studySessionId, feature, createdAt])
  @@index([feature, status, createdAt])
  @@map("AIUsageEvent")
}

model TutorResponseFeedback {
  id          String @id @default(cuid())
  studentId   String
  targetType  TutorFeedbackTarget
  targetId    String
  rating      TutorFeedbackRating
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([rating, createdAt])
}

model LearningEvent {
  id                  String @id @default(cuid())
  deduplicationKey    String? @unique
  studentId           String
  studySessionId      String?
  learningObjectiveId String?
  eventType           LearningEventType
  metadata            Json?
  createdAt           DateTime @default(now())
  student             StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studySession        StudySession? @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  learningObjective   LearningObjective? @relation(fields: [learningObjectiveId], references: [id], onDelete: SetNull)

  @@index([studentId, eventType, createdAt])
  @@index([studySessionId, createdAt])
  @@index([learningObjectiveId, eventType])
}

model ConceptMessage {
  id               String @id @default(cuid())
  conceptSessionId String
  submissionId     String? @unique
  role             MessageRole
  content          String
  createdAt        DateTime @default(now())
  session          ConceptSession @relation(fields: [conceptSessionId], references: [id], onDelete: Cascade)
  assessment       ConceptAssessment?

  @@index([conceptSessionId, createdAt])
}

model ConceptAssessment {
  id                 String @id @default(cuid())
  conceptMessageId   String @unique
  learningObjectiveId String?
  questionIntent      QuestionIntent?
  questionFingerprint String?
  rating             AssessmentRating
  evidenceLevel      String?
  masteryDelta       Float
  conceptMasteryBefore Float?
  conceptMasteryAfter  Float?
  objectiveMasteryBefore Float?
  objectiveMasteryAfter  Float?
  rationale          String
  providerResponseId String?
  model              String
  promptVersion      String
  inputTokens        Int?
  outputTokens       Int?
  latencyMs          Int?
  knowledgeLocators  Json?
  createdAt          DateTime @default(now())
  message            ConceptMessage @relation(fields: [conceptMessageId], references: [id], onDelete: Cascade)
  learningObjective  LearningObjective? @relation(fields: [learningObjectiveId], references: [id], onDelete: SetNull)

  @@index([learningObjectiveId, questionIntent])
}

